# Environment Configuration
# Copy this file to .env and fill in your keys
#
# You can also configure the LLM provider via the web UI at /setup
# after starting the application. The UI writes to SQLite (app_settings
# table) which takes precedence over these env vars.

LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Path to the local SQLite database.
# Docker: the DB lives on a named volume at /app/db/cora.db (see docker-compose.yml).
# Local dev: use a relative path like sqlite:///data/cora.db (creates ./data/cora.db).
DATABASE_URL=sqlite:////app/db/cora.db
# SQLite journal mode. WAL is the default and works in both Docker (named volume)
# and local dev. The named volume uses the Docker storage driver (Linux VM filesystem),
# which supports WAL's shared-memory (mmap) requirement. Don't change this unless
# you know your filesystem doesn't support mmap.
# SQLITE_JOURNAL_MODE=WAL

# -----------------------------------------------------------------------------
# Vector Store Configuration (Qdrant)
# -----------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=cora_dense_only

# -----------------------------------------------------------------------------
# LLM Provider (answer generation, routing, query rewriting)
# -----------------------------------------------------------------------------
# The LLM provider is selected at runtime through the /setup UI (writes to SQLite
# app_settings) and takes precedence over .env. For first-time setup you can also
# set one of the API keys below; Cora auto-detects the provider from them.
#
# Supported providers:
#   gemini  (default)  - Set GEMINI_API_KEY.
#   openai_compatible  - Set OPENAI_API_KEY for OpenAI, or OPENROUTER_API_KEY for
#                        OpenRouter. Defaults: OpenAI -> gpt-4.1-mini,
#                        OpenRouter -> google/gemini-2.5-flash.
#   Ollama / vLLM      - Configure base URL and model in the /setup UI (no API
#                        key needed).
#
# If multiple keys are set, the chat UI shows a toggle to switch providers.
# Automatic 429/quota fallback to the alternate configured provider is enabled
# when the opposite env key is also present.
#
# Model overrides (optional): the defaults above are tested recommendations.
# To use a different model without touching the Settings UI, set these:
#   OPENAI_MODEL=gpt-4.1-mini
#   OPENAI_MODEL_LITE=gpt-4.1-mini
#   OPENROUTER_MODEL=google/gemini-2.5-flash
#   OPENROUTER_MODEL_LITE=google/gemini-2.5-flash
# Note: once you save LLM settings via the UI, the DB profile takes precedence
# over these env vars. Update the model in Settings to change it at runtime.

GEMINI_API_KEY=your_gemini_api_key_here

# --- OpenAI-compatible provider keys (uncomment one to enable) ---
# OPENAI_API_KEY=your_openai_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Optional model overrides (uncomment to change the default model) ---
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_MODEL_LITE=gpt-4.1-mini
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_MODEL_LITE=google/gemini-2.5-flash

# -----------------------------------------------------------------------------
# Search Provider (supplementary web search)
# -----------------------------------------------------------------------------
# Supported: tavily (default), none
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here
# SEARCH_PROVIDER=none  # Disable web search — answer only from local documents

# -----------------------------------------------------------------------------
# Embedding Provider (document vectorization)
# -----------------------------------------------------------------------------
# Supported: voyage (default), cohere, ollama (local), openai
# Dimension must match the Qdrant collection vector size.
# If you change provider or dimension, re-ingest all documents.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_DIM=1024
# EMBEDDING_BATCH_SIZE=256  # Max texts per embedding request (provider-dependent)
#
# API keys: the keys below are .env fallbacks. When you save an API key via the
# Settings UI, it is stored in a per-subsystem scoped DB key
# (embedding_voyage_api_key / embedding_cohere_api_key / embedding_openai_api_key)
# so the embeddings and reranker subsystems never share a key. The scoped DB key
# takes precedence; the .env key here is used when no scoped key is set.
VOYAGE_API_KEY=your_voyage_api_key_here
# COHERE_API_KEY=your_cohere_api_key_here    # Required when EMBEDDING_PROVIDER=cohere
# OLLAMA_BASE_URL=http://localhost:11434     # For EMBEDDING_PROVIDER=ollama (local)
# OPENAI_API_KEY=your_openai_api_key_here    # Required when EMBEDDING_PROVIDER=openai

# -----------------------------------------------------------------------------
# Reranker Provider (retrieval quality improvement)
# -----------------------------------------------------------------------------
# Supported: voyage (default), cohere, none (skip — fully offline)
RERANK_PROVIDER=voyage
RERANK_MODEL=rerank-2.5
# RERANK_PROVIDER=none  # Disable reranking
#
# API keys: same scoped-key model as embeddings. Settings UI saves to
# reranker_voyage_api_key / reranker_cohere_api_key (per-subsystem DB keys).
# The VOYAGE_API_KEY / COHERE_API_KEY .env values above are shared fallbacks,
# used only when no scoped key is set.

# -----------------------------------------------------------------------------
# Chunking (indexing-time — affects document ingestion only)
# -----------------------------------------------------------------------------
# Tuned via A/B test: 1500/300 won on faithfulness + completeness.
# Changing these requires re-indexing existing documents to take effect.
CHUNK_SIZE=1500
CHUNK_OVERLAP=300

# -----------------------------------------------------------------------------
# KB Relevance Filtering (four-layer defense chain — see CLAUDE.md)
# -----------------------------------------------------------------------------
# Layer 1: hard rerank floor (docs below this are dropped post-rerank)
RERANK_SCORE_THRESHOLD=0.2
# Layer 1: zero-cost lexical overlap guard (opt-in — computes MAX overlap
# across both the original and rewritten query forms so acronym expansion
# doesn't unfairly lower overlap). 0.0 = disabled.
QUERY_DOC_OVERLAP_THRESHOLD=0.0
# Layer 2: pre-generation gate — if best doc's rerank score < this, skip KB → web
KB_MIN_TOP_RELEVANCE_SCORE=0.4
# Layer 4: post-generation web-supplement relevance check. Disable to skip the
# relevance judge without disabling the separate grounding-validation step.
ENABLE_WEB_SUPPLEMENT_RELEVANCE_CHECK=true
# Per-collection JSON overrides for any of the above thresholds.
# Example: {"my_collection": {"KB_MIN_TOP_RELEVANCE_SCORE": 0.5}}
# COLLECTION_RELEVANCE_OVERRIDES=

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# SQLite persistent cache (survives application restarts)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400

# PII redaction before storing conversation memory
# Set to false to disable (e.g. for local-only deployments where you own the data)
PII_REDACTION_ENABLED=true

# Secret key for signing conversation history and anonymizing memory user IDs.
# AUTO-GENERATED on first run and persisted to SQLite — no setup needed.
# Set it here only if you want to use your own key (e.g. for multi-instance deployments
# that need to share signed history). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# -----------------------------------------------------------------------------
# Document Ingestion — PDF Conversion Modes
# -----------------------------------------------------------------------------
# standard: Docling classical pipeline (layout model + RapidOCR + TableFormer).
#           Free, runs on CPU, local (no data leaves the machine). Preserves
#           headings, tables, and reading order; OCRs scanned pages.
#           ~1-2s/page on properly provisioned hardware. No VLM is loaded.
# llm_api:  AI service (Gemini/OpenAI), high accuracy on complex layouts, images,
#           and formulas. Requires a paid API key. ~$0.002/page.
#           Power users: point llm_api at a local vLLM server (e.g. PaddleOCR-VL-1.6)
#           by setting OPENAI_BASE_URL=http://localhost:8001/v1 — a config change.
# DOCUMENT_PDF_RENDER_DPI=200
# Cap how many documents are converted/indexed simultaneously. Docling parsing is
# CPU/RAM-heavy and embeddings are network-bound; a low cap keeps the app responsive.
# DOCUMENT_INGESTION_CONCURRENCY=2

# Per-document time budget for Standard-mode Docling parsing (seconds).
# Docling will stop and return PARTIAL_SUCCESS when this is exceeded; Cora surfaces
# that as a clear timeout error instead of indexing an incomplete document. 1800 = 30 min.
# DOCUMENT_DOCLING_TIMEOUT=1800

# Extra time (seconds) added on top of DOCUMENT_DOCLING_TIMEOUT to form the hard
# asyncio.wait_for ceiling around the entire process/reindex job. If a job exceeds
# this total it is cancelled and marked failed so a hung call cannot hold a worker
# slot or per-document lock forever.
# DOCUMENT_JOB_HARD_TIMEOUT_MARGIN_SECONDS=120

# --- Ingest-worker tuning (only used when INGESTION_DISPATCH=worker) ---
# How often the worker writes a heartbeat to app_settings (seconds).
# INGEST_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
# A heartbeat older than this means the worker is not running; the API warns users.
# INGEST_WORKER_STALE_SECONDS=30
# Run the stuck-job sweep every N poll cycles (avoids redundant DB writes).
# INGEST_WORKER_STALE_SWEEP_EVERY_N_POLLS=5
# Grace period (seconds) added to DOCUMENT_DOCLING_TIMEOUT for the stuck-job sweep.
# A 'processing' job older than DOCUMENT_DOCLING_TIMEOUT + this is presumed hung.
# Should be > DOCUMENT_JOB_HARD_TIMEOUT_MARGIN_SECONDS so the hard timeout fires
# first for live tasks (better error message + task cancellation); the sweep then
# only catches orphaned jobs from crashed workers.
# INGEST_WORKER_STALE_GRACE_SECONDS=180

# Max Qdrant points per upsert request. Lower this if you see gRPC/HTTP payload
# errors on documents that produce many chunks.
# QDRANT_UPSERT_BATCH_SIZE=1000

# For local development without docker you can specify:
# CORS_ORIGINS=http://localhost:8080,http://localhost:8000
